# ─── Supabase ────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Server ──────────────────────────────────────────────
PORT=8443

# ─── CORS – danh sách origin cho phép (phân cách bằng dấu phẩy) ──

# ─── Frontend URL (dùng cho redirect link email, etc.) ───
FRONTEND_URL=http://localhost:5173

# ─── AI OCR Service ─────────────────────────────────────
OCR_SERVICE_URL=http://localhost:8000

# ─── VNPT eKYC ───────────────────────────────────────────
VNPT_TOKEN_ID=your-vnpt-token-id
VNPT_TOKEN_KEY=your-vnpt-token-key
VNPT_ACCESS_TOKEN=bearer your-vnpt-access-token
VNPT_EKYC_URL=https://api.ekyc.vnpt.vn/v1/ocr

# ─── VNPay ───────────────────────────────────────────────
VNP_TMN_CODE=your-vnp-tmn-code
VNP_HASH_SECRET=your-vnp-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://your-domain/api/payments/vnpay-return
VNP_IPN_URL=https://your-domain/api/payments/vnpay-ipn

# ─── Email (Resend) ─────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
RESEND_API_URL=your-resend-api-url
MAIL_FROM=noreply@your-domain.com
